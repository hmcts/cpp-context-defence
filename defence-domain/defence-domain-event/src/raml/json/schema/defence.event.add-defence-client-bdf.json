{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://moj.gov.uk/cpp/defence/events/defence.event.add-defence-client-bdf",
  "type": "object",
  "properties": {
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date"
    },
    "isVisible": {
      "type": "boolean"
    },
    "idpcDetailsId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "caseId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "defendantId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "isLockedByRepOrder": {
      "type": "boolean"
    },
    "associatedOrganisationId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "organisationName": {
      "type": "string"
    }
  },
  "required": [
    "firstName",
    "lastName",
    "dateOfBirth",
    "isVisible",
    "idpcDetailsId",
    "caseId",
    "defendantId",
    "isLockedByRepOrder"
  ]
}